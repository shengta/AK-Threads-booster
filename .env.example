# ===========================================
# AK-Threads-Booster Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Threads API Configuration (Required for patrol and refresh)
# Get your token from: https://developers.facebook.com/apps/
# Required permissions: threads_basic, threads_keyword_search, 
#                       threads_content_publish, threads_manage_replies
THREADS_ACCESS_TOKEN=your_long_lived_token_here

# Optional: LLM API Keys for Reply Drafting
# If not set, the patrol system will use template replies
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Dry-run mode (set to 1 to test without API calls)
PATROL_DRY_RUN=0

# Optional: Custom paths
# PATROL_CONFIG_PATH=patrol_config.json
# PATROL_DB_PATH=patrol_threads.db
